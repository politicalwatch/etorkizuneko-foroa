# Copiar a `front/.env` y rellenar. `.env` está en .gitignore.

# ID del proyecto de Sanity. OBLIGATORIA: sin ella el build se detiene.
# No es un secreto (viaja al navegador en las URLs del CDN de imágenes), pero
# se pasa por entorno para no fijar el proyecto en el repositorio.
# Se obtiene con `npx sanity debug` desde studio/, o en sanity.io/manage.
NUXT_PUBLIC_SANITY_PROJECT_ID=

# Token de lectura de Sanity, rol "Viewer" (solo lectura).
# Necesario para leer borradores en la previsualización.
#
# IMPORTANTE: este token NO debe ir en la opción `sanity.token` de
# nuxt.config.ts — el módulo la publica en runtimeConfig.public y acabaría en
# el bundle del navegador. Va en `sanity.visualEditing.token`, que se queda en
# el runtimeConfig privado (servidor).
#
# Debe estar presente en BUILD TIME: si falta, el módulo desactiva el visual
# editing con un warning y las rutas /preview/* no se registran.
NUXT_SANITY_VISUAL_EDITING_TOKEN=

# Origen del Sanity Studio (el que abre el iframe de previsualización).
# Local: http://localhost:3333 · Desplegado: https://<nombre>.sanity.studio
NUXT_PUBLIC_SANITY_VISUAL_EDITING_STUDIO_URL=http://localhost:3333

# Dataset. Sin definir = production. Descomentar para el sandbox local.
# Debe coincidir con SANITY_STUDIO_DATASET en studio/.env.
# NUXT_PUBLIC_SANITY_DATASET=dev
