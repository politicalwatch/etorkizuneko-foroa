# Copiar a `studio/.env` y rellenar. `.env` está en .gitignore.
#
# Solo las variables con prefijo SANITY_STUDIO_ llegan al bundle del Studio.

# Origen del front que se carga en el iframe de "Previsualizar".
# Lleva /es porque i18n usa strategy: 'prefix' y no existe ruta sin prefijo.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000/es

# Dataset. Sin definir = production. Descomentar para el sandbox local.
# Debe coincidir con NUXT_PUBLIC_SANITY_DATASET en front/.env.
# SANITY_STUDIO_DATASET=dev
